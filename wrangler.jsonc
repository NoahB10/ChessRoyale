{
  // Cloudflare Workers (static assets) config for ChessRoyale.
  // Deploy: BASE_PATH=/ npm run build && npx wrangler deploy
  "name": "chessroyale",
  "compatibility_date": "2026-06-01",
  // Custom domain is the canonical URL; skip the *.workers.dev subdomain.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // SPA fallback: serve index.html for unknown paths instead of a 404.
    "not_found_handling": "single-page-application"
  },
  // Auto-provisions the custom domain (DNS record + SSL) on deploy,
  // since one10designs.com is a zone in this Cloudflare account.
  "routes": [
    { "pattern": "chessroyale.one10designs.com", "custom_domain": true }
  ]
}
